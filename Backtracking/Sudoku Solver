class Solution {
    public static void print(char [][] board){
    for(int i=0;i<board.length;i++){
        for(int j=0;j<board.length;j++){
           System.out.print(board[i][j]+" ");
        }
    }
    }
    public static boolean isSafe(char [][] board,int row,int col,int digit){
         char ch = (char)(digit + '0');

        for(int i=0;i<=8;i++){
            if(board[i][col]==ch){
                return false;
            }
        }

        for(int j=0;j<=8;j++){
            if(board[row][j]==ch){
                return false;
            }
        }

       int sr=(row/3)*3;
       int sc=(col/3)*3;

       for(int i=sr;i<sr+3;i++){
        for(int j=sc;j<sc+3;j++){
            if(board[i][j]==ch){
                return false;
            }
        }
       }
       return true;

    }
    public static boolean function(char [][] board,int row,int col){
     if(row==9) return true;
       int newRow=row;
       int newCol=col+1;
       if(col+1==9){
        newRow=newRow+1;
        newCol=0;
       }
     if(board[row][col]!='.'){
        return function(board,newRow,newCol);
     }
     for(int i=1;i<=9;i++){
        if(isSafe(board,row,col,i)){
        board[row][col]=(char)(i+'0');
       if(function(board,newRow,newCol)){
        return true;
       }
       board[row][col]='.';
     }
     }
     return false;
     }
    public void solveSudoku(char[][] board) {
        
       boolean check= function(board,0,0);
       if(check){
        print(board);
       }
    }
}
